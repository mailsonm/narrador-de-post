msgid "Ouvir este artigo"
msgstr "Listen to this article"

#: narrador-de-post.php:88
msgid "Pausar"
msgstr "Pause"

#: narrador-de-post.php:89
msgid "Continuar"
msgstr "Resume"

#: narrador-de-post.php:90
msgid "Parar"
msgstr "Stop"

#: narrador-de-post.php:91
msgid "minutos de áudio"
msgstr "minutes of audio"

#: narrador-de-post.php:92
msgid "Seu navegador não possui suporte à síntese de voz."
msgstr "Your browser does not support text-to-speech synthesis."

#: narrador-de-post.php:395
msgid "1. Modo de Operação do Player"
msgstr "1. Player Operating Mode"

#: narrador-de-post.php:398
msgid "Selecione a Tecnologia:"
msgstr "Select Technology:"

#: narrador-de-post.php:403
msgid "Modo Gratuito (Vozes Neurais do Navegador)"
msgstr "Free Mode (Browser Neural Voices)"

#: narrador-de-post.php:404
msgid "100% gratuito e sem custos de API. Utiliza sintetizadores neurais de alta qualidade nativos do dispositivo do usuário (Edge/Chrome/Safari)."
msgstr "100% free with zero API costs. Uses high-quality native neural synthesizers on the user device (Edge/Chrome/Safari)."

#: narrador-de-post.php:408
msgid "Modo IA de Alta Fidelidade (OpenAI TTS - BYOK)"
msgstr "High-Fidelity AI Mode (OpenAI TTS - BYOK)"

#: narrador-de-post.php:409
msgid "Áudio com qualidade de podcast profissional. O áudio é sintetizado via sua chave OpenAI e salvo em MP3 no WordPress."
msgstr "Studio-quality podcast audio. Audio is synthesized using your OpenAI key and cached as MP3 in WordPress."

