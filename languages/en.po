msgid "Texto do Botão:"
msgstr "Button Label:"

#: narrador-de-post.php:425
msgid "Idioma Principal:"
msgstr "Primary Language:"

#: narrador-de-post.php:436
msgid "Velocidade Padrão:"
msgstr "Default Speed:"

#: narrador-de-post.php:448
msgid "Tempo Estimado:"
msgstr "Estimated Time:"

#: narrador-de-post.php:452
msgid "Exibir badge com tempo estimado de áudio (ex: ⏱️ ~3 min)"
msgstr "Display badge with estimated audio duration (e.g. ⏱️ ~3 min)"

#: narrador-de-post.php:458
msgid "3. Chave de API OpenAI (Opcional para Modo IA)"
msgstr "3. OpenAI API Key (Optional for AI Mode)"

#: narrador-de-post.php:461
msgid "OpenAI API Key:"
msgstr "OpenAI API Key:"

#: narrador-de-post.php:464
msgid "Sua chave privada da OpenAI. O áudio gerado fica armazenado no seu WordPress e não consome API em novas visitas."
msgstr "Your private OpenAI key. Generated audio is stored in WordPress and does not incur API costs on repeat visits."

#: narrador-de-post.php:468
msgid "Voz da OpenAI:"
msgstr "OpenAI Voice:"

